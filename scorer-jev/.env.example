# Only needed for the optional, paid re-scoring (`pnpm score`). The map and `pnpm data` need no key.
# Copy to scorer-jev/.env (loaded automatically; git-ignored) or export in your shell.
# Only ONE key is needed. If both are set, the direct TypeSafe route wins unless JEV_ROUTE=gateway.

# Route 1 - TypeSafe API directly (POST https://api.typesafe.ai/v1/systemone, Bearer auth)
TYPESAFE_API_KEY=

# Route 2 - Vercel AI Gateway (AI SDK `experimental_evaluate`, model `typesafe-ai/jev`)
AI_GATEWAY_API_KEY=

# Optional overrides
# JEV_ROUTE=auto            # auto | typesafe | gateway
# JEV_MODEL=                # default: jev-latest (typesafe) / typesafe-ai/jev (gateway). Pin jev-1.13.0 for stable thresholds.
# TYPESAFE_BASE_URL=https://api.typesafe.ai
